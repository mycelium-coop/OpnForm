APP_NAME=OpnForm
APP_ENV=production
APP_KEY={{ lookup('ansible.builtin.env', 'APP_KEY') }}
APP_DEBUG=false
APP_URL=https://{{ opnform_hostname }}
FRONT_URL=https://{{ opnform_hostname }}
LOG_CHANNEL=errorlog
LOG_LEVEL=warning
FRONT_API_SECRET={{ lookup('ansible.builtin.env', 'FRONT_API_SECRET') }}
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE={{ lookup('ansible.builtin.env', 'DB_DATABASE') }}
DB_USERNAME={{ lookup('ansible.builtin.env', 'DB_USERNAME') }}
DB_PASSWORD={{ lookup('ansible.builtin.env', 'DB_PASSWORD') }}
FILESYSTEM_DRIVER=local
LOCAL_FILESYSTEM_VISIBILITY=public
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD={{ lookup('ansible.builtin.env', 'REDIS_PASSWORD') }}
MAIL_MAILER={{ lookup('ansible.builtin.env', 'MAIL_MAILER') }}
MAIL_HOST={{ lookup('ansible.builtin.env', 'MAIL_HOST') }}
MAIL_PORT={{ lookup('ansible.builtin.env', 'MAIL_PORT') }}
MAIL_USERNAME={{ lookup('ansible.builtin.env', 'MAIL_USERNAME') }}
MAIL_PASSWORD={{ lookup('ansible.builtin.env', 'MAIL_PASSWORD') }}
MAIL_ENCRYPTION={{ lookup('ansible.builtin.env', 'MAIL_ENCRYPTION') }}
MAIL_FROM_ADDRESS={{ lookup('ansible.builtin.env', 'MAIL_FROM_ADDRESS') }}
MAIL_FROM_NAME={{ lookup('ansible.builtin.env', 'MAIL_FROM_NAME') }}
JWT_SECRET={{ lookup('ansible.builtin.env', 'JWT_SECRET') }}
JWT_SKIP_IP_UA_VALIDATION=false
PUBLIC_UPLOADS_RATE_LIMIT_PER_MINUTE=30
PUBLIC_UPLOADS_RATE_LIMIT_PER_HOUR=300
OIDC_FORCE_LOGIN={{ lookup('ansible.builtin.env', 'OIDC_FORCE_LOGIN') }}
OIDC_RATE_LIMIT_PER_MINUTE={{ lookup('ansible.builtin.env', 'OIDC_RATE_LIMIT_PER_MINUTE') }}
# Docker DNAT presents the host Caddy connection through the dedicated network
# gateway. Only this isolated network reaches the PHP-FPM service.
TRUSTED_PROXIES={{ opnform_docker_subnet }}
PHP_MEMORY_LIMIT=1G
PHP_MAX_EXECUTION_TIME=600
PHP_UPLOAD_MAX_FILESIZE=64M
PHP_POST_MAX_SIZE=64M
