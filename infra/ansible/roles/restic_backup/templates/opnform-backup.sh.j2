#!/usr/bin/env bash
set -euo pipefail

load_environment() {
  local line key value
  while IFS= read -r line || [[ -n "${line}" ]]; do
    case "${line}" in
      ''|'#'*) continue ;;
      *=*)
        key="${line%%=*}"
        value="${line#*=}"
        export "${key}=${value}"
        ;;
      *) printf 'Invalid backup environment line.\n' >&2; exit 1 ;;
    esac
  done < /opt/opnform/secrets/backup.env
}

load_environment
mkdir -p "${OPNFORM_BACKUP_DIR}"
umask 077
dump_path="${OPNFORM_BACKUP_DIR}/opnform.sqlc"
storage_mount="$(docker volume inspect "${OPNFORM_PROJECT_NAME}_opnform_storage" --format '{% raw %}{{ .Mountpoint }}{% endraw %}')"

if ! restic snapshots >/dev/null 2>&1; then
  restic init >/dev/null
fi

docker compose -f "${OPNFORM_COMPOSE_FILE}" exec -T db pg_dump -U "${DB_USERNAME}" -Fc "${DB_DATABASE}" >"${dump_path}"
backup_result="$(restic backup --json "${dump_path}" "${storage_mount}" --tag opnform)"
snapshot_id="$(printf '%s\n' "${backup_result}" | jq -r 'select(.message_type == "summary") | .snapshot_id')"
restic forget --prune --keep-daily "${BACKUP_KEEP_DAILY}" --keep-weekly "${BACKUP_KEEP_WEEKLY}" --keep-monthly "${BACKUP_KEEP_MONTHLY}" >/dev/null
printf '%s\n' "${snapshot_id}"
