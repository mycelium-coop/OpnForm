#!/usr/bin/env bash
set -euo pipefail

while IFS= read -r line || [[ -n "${line}" ]]; do
  case "${line}" in
    ''|'#'*) continue ;;
    *=*) export "${line}" ;;
    *) printf 'Invalid backup environment line.\n' >&2; exit 1 ;;
  esac
done < /opt/opnform/secrets/backup.env

restic check --read-data-subset=1/20
