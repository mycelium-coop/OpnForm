# Generated by `just env` from 1Password. Do not edit the generated .env file.
# Non-secret defaults may be changed after rendering; retain shell-safe quoting.

# Deployment identity
DEPLOYMENT_NAME=opnform-prod
VPS_MODE=create
VPS_SERVICE_NAME=
VPS_DISPLAY_NAME=opnform-prod
VPS_SUBSIDIARY={{ op://tech-admin/opnform-secrets/ovh-subsidiary }}
VPS_PLAN_CODE={{ op://tech-admin/opnform-secrets/ovh-vps-plan-code }}
# Mandatory cart options for modern OVH VPS plans (comma-separated plan codes).
# For vps-2027-model1 these are public catalog codes, not secrets. Switch to
# option-auto-backup-2027-7-model1 for the 7-day premium backup addon.
VPS_PLAN_OPTION_CODES=option-linux,option-storage-local-2027-model1,option-auto-backup-2027-1-model1
VPS_PLAN_DURATION=P1M
VPS_PRICING_MODE=default
VPS_DATACENTER={{ op://tech-admin/opnform-secrets/ovh-vps-datacenter }}
VPS_OS="Ubuntu 26.04"
VPS_IMAGE_ID={{ op://tech-admin/opnform-secrets/ovh-vps-image-id }}

# OVH provider credentials
OVH_ENDPOINT=ovh-us
OVH_APPLICATION_KEY={{ op://tech-admin/opnform-secrets/ovh-application-key }}
OVH_APPLICATION_SECRET={{ op://tech-admin/opnform-secrets/ovh-application-secret }}
OVH_CONSUMER_KEY={{ op://tech-admin/opnform-secrets/ovh-consumer-key }}

# Cloudflare DNS, R2 state, and backup storage
CLOUDFLARE_API_TOKEN={{ op://tech-admin/opnform-secrets/cloudflare-api-token }}
# Dedicated token for Caddy ACME DNS-01 (Zone:Read + DNS:Edit). Keep separate
# from CLOUDFLARE_API_TOKEN used by OpenTofu.
CLOUDFLARE_DNS_API_TOKEN={{ op://tech-admin/opnform-secrets/cloudflare-dns-api-token }}
CLOUDFLARE_ACCOUNT_ID={{ op://tech-admin/opnform-secrets/cloudflare-account-id }}
CLOUDFLARE_ZONE_ID={{ op://tech-admin/opnform-secrets/cloudflare-zone-id }}
CLOUDFLARE_MANAGE_SSL_SETTING=true
CLOUDFLARE_MANAGE_IPV6_RECORD=true
CLOUDFLARE_PROXIED=true
# Optional Healthchecks.io (or compatible) ping URL for the IP sync timer.
CLOUDFLARE_IP_SYNC_HEALTHCHECKS_URL=
OPNFORM_HOSTNAME={{ op://tech-admin/opnform-secrets/opnform-hostname }}
CADDY_EMAIL={{ op://tech-admin/opnform-secrets/caddy-email }}
R2_ACCOUNT_ID={{ op://tech-admin/opnform-secrets/r2-account-id }}
R2_STATE_BUCKET={{ op://tech-admin/opnform-secrets/r2-state-bucket }}
R2_BACKUP_BUCKET={{ op://tech-admin/opnform-secrets/r2-backup-bucket }}
R2_STATE_ACCESS_KEY_ID={{ op://tech-admin/opnform-secrets/r2-state-access-key-id }}
R2_STATE_SECRET_ACCESS_KEY={{ op://tech-admin/opnform-secrets/r2-state-secret-access-key }}
R2_BACKUP_ACCESS_KEY_ID={{ op://tech-admin/opnform-secrets/r2-backup-access-key-id }}
R2_BACKUP_SECRET_ACCESS_KEY={{ op://tech-admin/opnform-secrets/r2-backup-secret-access-key }}
RESTIC_PASSWORD={{ op://tech-admin/opnform-secrets/restic-password }}

# Administrative access
DEPLOY_USER=opnform
ANSIBLE_SSH_USER=ubuntu
SSH_PORT=22
SSH_PUBLIC_KEY_PATH={{ op://tech-admin/opnform-secrets/deploy-ssh-public-key-path }}
SSH_PRIVATE_KEY_PATH={{ op://tech-admin/opnform-secrets/deploy-ssh-private-key-path }}
SSH_ALLOWED_CIDRS={{ op://tech-admin/opnform-secrets/ssh-allowed-cidrs }}
# KVM/console break-glass password. Created automatically by `just env` / deploy
# when missing from the opnform-secrets item; SSH password auth stays disabled.
OVH_SSH_PASSWORD={{ op://tech-admin/opnform-secrets/ovh-ssh-password }}

# Native systemd Caddy settings
CADDY_SERVICE_NAME=caddy
CADDY_CONFIG_PATH=/etc/caddy/Caddyfile
CADDY_SNIPPET_DIR=/etc/caddy/conf.d
CADDY_PACKAGE_VERSION=
CADDY_ORIGIN_LOCKDOWN=true
OPNFORM_DOCKER_SUBNET=172.30.40.0/24
OPNFORM_INGRESS_IP=172.30.40.10

# Private GHCR image registry
GHCR_HOST=ghcr.io
GHCR_OWNER={{ op://tech-admin/opnform-secrets/ghcr-owner }}
GHCR_API_REPOSITORY=opnform-api
GHCR_CLIENT_REPOSITORY=opnform-client
GHCR_PUSH_USERNAME={{ op://tech-admin/opnform-secrets/ghcr-push-username }}
GHCR_PUSH_TOKEN={{ op://tech-admin/opnform-secrets/ghcr-push-token }}
GHCR_PULL_USERNAME={{ op://tech-admin/opnform-secrets/ghcr-pull-username }}
GHCR_PULL_TOKEN={{ op://tech-admin/opnform-secrets/ghcr-pull-token }}
IMAGE_PLATFORM=linux/amd64
OPNFORM_API_IMAGE=
OPNFORM_CLIENT_IMAGE=
OPNFORM_POSTGRES_IMAGE={{ op://tech-admin/opnform-secrets/postgres-image }}
OPNFORM_REDIS_IMAGE={{ op://tech-admin/opnform-secrets/redis-image }}
OPNFORM_NGINX_IMAGE={{ op://tech-admin/opnform-secrets/nginx-image }}
RELEASE_ID=

# Application, database, cache, and SMTP secrets
APP_KEY={{ op://tech-admin/opnform-secrets/app-key }}
JWT_SECRET={{ op://tech-admin/opnform-secrets/jwt-secret }}
FRONT_API_SECRET={{ op://tech-admin/opnform-secrets/front-api-secret }}
DB_DATABASE=opnform
DB_USERNAME=opnform
DB_PASSWORD={{ op://tech-admin/opnform-secrets/database-password }}
REDIS_PASSWORD={{ op://tech-admin/opnform-secrets/redis-password }}
MAIL_MAILER=smtp
MAIL_HOST={{ op://tech-admin/opnform-secrets/smtp-host }}
MAIL_PORT={{ op://tech-admin/opnform-secrets/smtp-port }}
MAIL_USERNAME={{ op://tech-admin/opnform-secrets/smtp-username }}
MAIL_PASSWORD={{ op://tech-admin/opnform-secrets/smtp-password }}
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS={{ op://tech-admin/opnform-secrets/smtp-from-address }}
MAIL_FROM_NAME=OpnForm

# First administrator and OIDC bootstrap. The initial administrator is used only
# while setup is open; leave OIDC_ENABLED=false to configure SSO manually later.
BOOTSTRAP_ADMIN_NAME={{ op://tech-admin/opnform-secrets/bootstrap-admin-name }}
BOOTSTRAP_ADMIN_EMAIL={{ op://tech-admin/opnform-secrets/bootstrap-admin-email }}
BOOTSTRAP_ADMIN_PASSWORD={{ op://tech-admin/opnform-secrets/bootstrap-admin-password }}
OIDC_ENABLED=false
OIDC_FORCE_LOGIN=false
OIDC_NAME={{ op://tech-admin/opnform-secrets/oidc-name }}
OIDC_SLUG={{ op://tech-admin/opnform-secrets/oidc-slug }}
OIDC_DOMAIN={{ op://tech-admin/opnform-secrets/oidc-domain }}
OIDC_ISSUER={{ op://tech-admin/opnform-secrets/oidc-issuer }}
OIDC_CLIENT_ID={{ op://tech-admin/opnform-secrets/oidc-client-id }}
OIDC_CLIENT_SECRET={{ op://tech-admin/opnform-secrets/oidc-client-secret }}
OIDC_SCOPES_JSON='["openid","profile","email"]'
OIDC_FIELD_MAPPINGS_JSON='{"email":"email","name":"name"}'
OIDC_GROUP_ROLE_MAPPINGS_JSON='[]'
OIDC_REQUIRE_STATE=true
OIDC_RATE_LIMIT_PER_MINUTE=100

# Backup retention
BACKUP_SCHEDULE="*-*-* 02:15:00"
BACKUP_KEEP_DAILY=7
BACKUP_KEEP_WEEKLY=4
BACKUP_KEEP_MONTHLY=6
